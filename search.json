---
layout: null
---
{%- assign pages = site.pages | where_exp: "p", "p.path != 'search.json'" -%}
[{%- for p in pages -%}
{"title":{{ p.title | default: p.name | jsonify }},"url":{{ p.url | relative_url | jsonify }},"text":{{ p.content | markdownify | strip_html | normalize_whitespace | truncatewords: 250 | jsonify }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]
